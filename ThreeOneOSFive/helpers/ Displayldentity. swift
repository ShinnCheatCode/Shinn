import Foundation
import UIKit

enum DisplayIdentity {
    static var attestationToken: String {
        let bundle = Bundle.main.bundleIdentifier ?? "unknown"
        let version = Bundle.main.object(forInfoDictionaryKey: "CFBundleShortVersionString") as? String ?? "0"
        let machine = AppInfo.machineName
        let osBuild = AppInfo.osBuild
        return "\(bundle)|\(version)|\(machine)|\(osBuild)"
    }
}

func DisplayIdentityAttestationToken() -> String {
    DisplayIdentity.attestationToken
}